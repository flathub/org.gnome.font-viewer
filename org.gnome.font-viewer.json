        "/share/gtk-doc",
        "*.la",
        ".a",
        "/lib/girepository-1.0",
        "/share/gir-1.0",
        "/share/doc"
    ],
    "modules": [
        {
            "name": "gnome-font-viewer",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-font-viewer/49/gnome-font-viewer-49.0.tar.xz",
                    "sha256": "7c018925c285771b55d7d1a6f15711c0c193d7450ed9871e20d44f2548562404",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gnome-font-viewer"
                    }
                }
            ]
        }
    ]
}
